<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Compose owns every in-app color (see MemoizationTheme); this theme only
      dresses the window, so it needs no View-system Material library.
    -->
    <style name="Theme.Memoization" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/purple_700</item>
    </style>

    <style name="Theme.Memoization.NoActionBar" parent="Theme.Memoization" />
</resources>
